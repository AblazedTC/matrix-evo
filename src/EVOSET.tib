// EVOSET - settings
Lbl M
"STEP-BY-STEP: OFF"→Str1
If ʟMXSET(1):"STEP-BY-STEP: ON"→Str1
Menu("SETTINGS",Str1,1,"RESET A, B AND R",2,"ABOUT",3,"BACK",0)
Lbl 1
not(ʟMXSET(1))→ʟMXSET(1)
Goto M
Lbl 2
{2,2,0,0,1,0,1,0,1,0,1}→ʟMXW
147→dim(ʟMXW)
ʟMXW→ʟMXA:ʟMXW→ʟMXB:ʟMXW→ʟMXR
ClrHome
Disp "A, B, R RESET TO","2X2 ZERO MATRICES"
Pause
Goto M
Lbl 3
ClrHome
Disp "MATRIX EVO 1.0","LINEAR ALGEBRA, CH. 1-4","EXACT FRACTIONS WHILE","NUMBERS STAY BELOW 1ᴇ10,","ELSE SHOWN AS APPROX.","MAX 6X6 (RESULTS 72 CELLS)","USES [G]-[J] AS WORKSPACE"
Pause
Goto M
Lbl 0
