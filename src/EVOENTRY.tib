// EVOENTRY - read the text in Str1 as an exact rational  [-]digits[.digits][/[-]digits[.digits]]
// Out: P/Q in lowest terms with Z=1.  Z=0: malformed or divides by zero.
// Text containing anything else (sqrt, pi, ...) is evaluated with expr( and returned
// as an approximate decimal with Z=2.
// Clobbers: A B C D E F G H K O R S Str9
1→Z:1→F
0→A:1→B:1→C:0→E:0→G
For(K,1,length(Str1))
sub(Str1,K,1)→Str9
inString("0123456789",Str9)→D
If D:Then
10A+D-1→A:G+1→G
If E:10B→B
If A≥ᴇ9 or B≥ᴇ9:Z+(Z=1)→Z
Else
If Str9=".":Then
If E:Z(Z=2)→Z
1→E
Else
If Str9="⁻" or Str9="-":Then
If G or E or C<0:Z(Z=2)→Z
⁻1→C
Else
If Str9="/":Then
If F=2 or not(G):Z(Z=2)→Z
CA→P:B→Q:2→F
0→A:1→B:1→C:0→E:0→G
Else
2→Z
End
End
End
End
End
If not(G):Z(Z=2)→Z
If Z=2:Then
expr(Str1)→P:1→Q
Return
End
If not(Z):Return
If F=1:Then
CA→P:B→Q
Else
CA→R:B→S
End
If P=0:Then
1→Q
Else
gcd(abs(P),Q)→G:P/G→P:Q/G→Q
End
If F=2:Then
If R=0:Then
0→Z:Return
End
gcd(abs(R),S)→G:R/G→R:S/G→S
V→E:0→V:0→W:4→O:prgmEVOFRAC
If V:2→Z
max(V,E)→V
End
